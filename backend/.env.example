# --- Ma'lumotlar bazasi ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=mydrone

# Entity'lardan sxemani avtomatik yaratish (migratsiya kerak emas).
# Prodda ehtiyot bo'ling — o'zgarishlar bazaga darrov qo'llanadi.
TYPEORM_SYNC=true

# Birinchi ishga tushirishda demo katalogni bazaga yozish
SEED_DEMO=true

# --- JWT ---
JWT_SECRET=mydrone-dev-secret-almashtiring
JWT_REFRESH_SECRET=mydrone-dev-refresh-secret-almashtiring
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# --- Server ---
PORT=4000
HOST=127.0.0.1
